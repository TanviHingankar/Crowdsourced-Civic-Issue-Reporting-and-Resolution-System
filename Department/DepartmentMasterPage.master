<%@ Master Language="C#" AutoEventWireup="true" CodeFile="DepartmentMasterPage.master.cs" Inherits="Department_DepartmentMasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Department Panel</title>

    <!-- ✅ IMPORTANT FOR MOBILE -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding-bottom: 75px;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            font-family: 'Segoe UI', sans-serif;
            color: white;
            overflow-x: hidden;
        }

        /* ===== Top Navbar ===== */
        .top-navbar {
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(12px);
            padding: 10px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-navbar h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

        .logout-btn {
            background: #ff4b5c;
            border: none;
            padding: 5px 12px;
            border-radius: 20px;
            color: white;
            font-size: 13px;
        }

        .logout-btn:hover {
            background: #ff1e38;
        }

        /* ===== Content ===== */
        .main-content {
            padding: 20px 15px;
        }

        /* ===== Bottom Menu ===== */
        .bottom-menu {
            position: fixed;
            bottom: 0;
            width: 100%;
            background: rgba(0,0,0,0.9);
            backdrop-filter: blur(15px);
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 8px 0;
            border-top: 1px solid rgba(255,255,255,0.2);
            z-index: 1000;
        }

        .bottom-menu a {
            flex: 1;
            text-align: center;
            color: white;
            text-decoration: none;
            font-size: 11px;
            transition: 0.3s;
        }

        .bottom-menu a i {
            display: block;
            font-size: 18px;
            margin-bottom: 2px;
        }

        .bottom-menu a:hover {
            color: #00d4ff;
        }

        .bottom-menu a.active {
            color: #00d4ff;
        }

        /* ===== Tablet View ===== */
        @media (min-width: 768px) {
            .top-navbar h4 {
                font-size: 22px;
            }

            .bottom-menu a {
                font-size: 13px;
            }

            .bottom-menu a i {
                font-size: 20px;
            }

            .main-content {
                padding: 30px;
            }
        }

    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>
<form id="form1" runat="server">

    <!-- ===== TOP NAVBAR ===== -->
    <div class="top-navbar">
        <h4>
            <i class="fas fa-building"></i>
            Department Panel
        </h4>

        <asp:LinkButton ID="btnLogout" runat="server"
            CssClass="logout-btn"
            OnClick="btnLogout_Click">
            <i class="fas fa-sign-out-alt"></i>
        </asp:LinkButton>
    </div>

    <!-- ===== PAGE CONTENT ===== -->
    <div class="main-content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>

    <!-- ===== MOBILE APP STYLE BOTTOM MENU ===== -->
    <div class="bottom-menu">

        <a href="DepartmentDashboard.aspx">
            <i class="fas fa-home"></i>
            Home
        </a>
            <a href="EditProfile.aspx">
            <i class="fas fa-tasks"></i>
            EditProfile
        </a>

        <a href="ViewAllIssue.aspx">
            <i class="fas fa-exclamation-circle"></i>
            Issues
        </a>

    

        <a href="ViewFeedback.aspx">
            <i class="fas fa-check-circle"></i>
            Feedback
        </a>

       <%-- <a href="DepartmentProfile.aspx">
            <i class="fas fa-user"></i>
            Profile
        </a>--%>

    </div>

</form>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>